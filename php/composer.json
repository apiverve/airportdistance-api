{
    "name": "apiverve/airportdistance",
    "description": "Airport Distance calculates the great-circle distance between two airports, plus estimated travel time, using their 3-letter IATA codes. It provides route distance in miles and kilometers plus estimated flight duration.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "airportdistance",
        "airport distance api",
        "airport distance",
        "distance between two airports",
        "distance between airports",
        "flight distance by iata"
    ],
    "homepage": "https://apiverve.com/marketplace/airportdistance?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/airportdistance",
        "source": "https://github.com/apiverve/airportdistance-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Airportdistance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Airportdistance\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
